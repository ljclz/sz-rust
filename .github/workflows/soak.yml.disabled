# SZ-Rust Soak Test — 长时稳定性测试
#
# 调度策略：
#   - 每周日 00:00 UTC（北京时间 08:00）自动运行 6h 完整 soak
#   - 支持手动触发（workflow_dispatch），可自定义时长
#
# 注：GitHub Actions 托管 runner 单 job 上限 6h，不再支持 24h，故从 24h 改为 6h
#
# 参考：sz-orm 的 soak.yml（保持结构一致性）

name: Soak Test

on:
  schedule:
    - cron: '0 0 * * 0'  # 每周日 00:00 UTC
  workflow_dispatch:
    inputs:
      soak_duration:
        description: 'Soak 时长（如 30m, 1h, 6h）'
        required: false
        default: '1h'
        type: string

# P3-2 修复：soak 与 soak-smoke 使用独立并发组，避免互相取消
# 之前共用 workflow 级 concurrency group 导致 push 时两 job 互相 cancel
concurrency:
  group: soak-${{ github.event_name }}-${{ github.run_id }}
  cancel-in-progress: false

jobs:
  soak:
    name: Soak Test (Linux)
    runs-on: ubuntu-latest
    timeout-minutes: 120  # 2 小时（1h soak + 1h 缓冲；P3-2：避免 6h 超时被 GitHub 强制取消）
    steps:
      - uses: actions/checkout@v4

      - name: Checkout sz-orm dependency
        run: git clone https://github.com/ljclz/sz-orm.git ../sz-orm

      - name: Install Rust toolchain (stable)
        uses: dtolnay/rust-toolchain@stable

      - name: Cache cargo registry
        uses: Swatinem/rust-cache@v2

      - name: Determine soak duration
        id: duration
        run: |
          if [ -n "${{ github.event.inputs.soak_duration }}" ]; then
            echo "value=${{ github.event.inputs.soak_duration }}" >> $GITHUB_OUTPUT
          else
            # P3-2：scheduled 默认 1h（GitHub hosted runner 硬上限 6h，6h 易超时被取消）
            echo "value=1h" >> $GITHUB_OUTPUT
          fi

      - name: Run Soak Test
        env:
          SOAK_DURATION: ${{ steps.duration.outputs.value }}
        run: |
          cargo test -p sz-rust-core --test soak -- --ignored --nocapture

      - name: Upload soak report
        if: always()
        uses: actions/upload-artifact@v4
        with:
          name: soak-report-${{ steps.duration.outputs.value }}
          path: target/soak-report.csv
          if-no-files-found: warn
          retention-days: 30

      - name: Notify on failure
        if: failure()
        run: |
          echo "::warning::Soak test failed — 请检查 soak-report.csv 中的退化检测项"
          exit 1

  # 冒烟模式：每次 push/PR 运行 10s soak
  soak-smoke:
    name: Soak Smoke Test (Linux, 10s)
    runs-on: ubuntu-latest
    if: github.event_name != 'schedule'
    steps:
      - uses: actions/checkout@v4

      - name: Checkout sz-orm dependency
        run: git clone https://github.com/ljclz/sz-orm.git ../sz-orm

      - name: Install Rust toolchain (stable)
        uses: dtolnay/rust-toolchain@stable

      - name: Cache cargo registry
        uses: Swatinem/rust-cache@v2

      - name: Run soak smoke test (10s)
        run: |
          cargo test --package sz-rust-core --test soak soak_smoke_10s -- --nocapture --test-threads=1

      - name: Upload soak smoke CSV report
        if: always()
        uses: actions/upload-artifact@v4
        with:
          name: soak-smoke-${{ github.sha }}
          path: target/soak-report.csv
          if-no-files-found: warn
          retention-days: 7
