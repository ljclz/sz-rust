{
  "annotations": {"list": []},
  "description": "sz300-server 综合监控面板",
  "editable": true,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [
    {"collapsed": false, "gridPos": {"h": 1, "w": 24, "x": 0, "y": 0}, "id": 100, "title": "概览", "type": "row"},
    {
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "fieldConfig": {"defaults": {"unit": "reqps"}},
      "gridPos": {"h": 8, "w": 6, "x": 0, "y": 1},
      "id": 1,
      "options": {"legend": {"displayMode": "list", "placement": "bottom"}},
      "title": "请求 QPS",
      "type": "timeseries",
      "targets": [{"expr": "sum(rate(sz300_requests_total{job=\"sz300-server\"}[1m]))", "legendFormat": "QPS", "refId": "A"}]
    },
    {
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "fieldConfig": {"defaults": {"unit": "s"}},
      "gridPos": {"h": 8, "w": 6, "x": 6, "y": 1},
      "id": 2,
      "options": {"legend": {"displayMode": "list", "placement": "bottom"}},
      "title": "请求延迟（P50/P95/P99）",
      "type": "timeseries",
      "targets": [
        {"expr": "histogram_quantile(0.50, sum(rate(sz300_request_duration_seconds_bucket{job=\"sz300-server\"}[5m])) by (le))", "legendFormat": "P50", "refId": "A"},
        {"expr": "histogram_quantile(0.95, sum(rate(sz300_request_duration_seconds_bucket{job=\"sz300-server\"}[5m])) by (le))", "legendFormat": "P95", "refId": "B"},
        {"expr": "histogram_quantile(0.99, sum(rate(sz300_request_duration_seconds_bucket{job=\"sz300-server\"}[5m])) by (le))", "legendFormat": "P99", "refId": "C"}
      ]
    },
    {
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "fieldConfig": {"defaults": {"unit": "percent", "thresholds": {"mode": "absolute", "steps": [{"color": "green"}, {"color": "yellow", "value": 1}, {"color": "red", "value": 5}]}}},
      "gridPos": {"h": 8, "w": 6, "x": 12, "y": 1},
      "id": 3,
      "options": {"legend": {"displayMode": "list", "placement": "bottom"}},
      "title": "错误率（5xx / 4xx）",
      "type": "timeseries",
      "targets": [
        {"expr": "sum(rate(sz300_requests_total{job=\"sz300-server\", status=~\"5..\"}[5m])) / sum(rate(sz300_requests_total{job=\"sz300-server\"}[5m])) * 100", "legendFormat": "5xx %", "refId": "A"},
        {"expr": "sum(rate(sz300_requests_total{job=\"sz300-server\", status=~\"4..\"}[5m])) / sum(rate(sz300_requests_total{job=\"sz300-server\"}[5m])) * 100", "legendFormat": "4xx %", "refId": "B"}
      ]
    },
    {
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "fieldConfig": {"defaults": {"unit": "short"}},
      "gridPos": {"h": 8, "w": 6, "x": 18, "y": 1},
      "id": 4,
      "options": {"legend": {"displayMode": "list", "placement": "bottom"}},
      "title": "Pod 副本数（期望/可用）",
      "type": "timeseries",
      "targets": [
        {"expr": "kube_deployment_spec_replicas{deployment=\"sz300-server\"}", "legendFormat": "期望", "refId": "A"},
        {"expr": "kube_deployment_status_replicas_available{deployment=\"sz300-server\"}", "legendFormat": "可用", "refId": "B"}
      ]
    }    ,
    {"collapsed": false, "gridPos": {"h": 1, "w": 24, "x": 0, "y": 9}, "id": 101, "title": "资源", "type": "row"},
    {
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "fieldConfig": {"defaults": {"unit": "percent"}},
      "gridPos": {"h": 8, "w": 6, "x": 0, "y": 10},
      "id": 5,
      "options": {"legend": {"displayMode": "list", "placement": "bottom"}},
      "title": "CPU 使用率（按 Pod）",
      "type": "timeseries",
      "targets": [
        {"expr": "rate(container_cpu_usage_seconds_total{container=\"sz300-server\"}[5m]) * 100", "legendFormat": "{{pod}}", "refId": "A"}
      ]
    },
    {
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "fieldConfig": {"defaults": {"unit": "bytes"}},
      "gridPos": {"h": 8, "w": 6, "x": 6, "y": 10},
      "id": 6,
      "options": {"legend": {"displayMode": "list", "placement": "bottom"}},
      "title": "内存使用（Working Set）",
      "type": "timeseries",
      "targets": [
        {"expr": "container_memory_working_set_bytes{container=\"sz300-server\"}", "legendFormat": "{{pod}}", "refId": "A"},
        {"expr": "container_spec_memory_limit_bytes{container=\"sz300-server\"}", "legendFormat": "limit", "refId": "B"}
      ]
    },
    {
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "fieldConfig": {"defaults": {"unit": "short"}},
      "gridPos": {"h": 8, "w": 6, "x": 12, "y": 10},
      "id": 7,
      "options": {"legend": {"displayMode": "list", "placement": "bottom"}},
      "title": "HPA 副本数 + 扩缩容目标",
      "type": "timeseries",
      "targets": [
        {"expr": "kube_hpa_status_current_replicas{hpa=\"sz300-server\"}", "legendFormat": "current", "refId": "A"},
        {"expr": "kube_hpa_status_desired_replicas{hpa=\"sz300-server\"}", "legendFormat": "desired", "refId": "B"},
        {"expr": "kube_hpa_spec_max_replicas{hpa=\"sz300-server\"}", "legendFormat": "max", "refId": "C"},
        {"expr": "kube_hpa_spec_min_replicas{hpa=\"sz300-server\"}", "legendFormat": "min", "refId": "D"}
      ]
    },
    {
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "fieldConfig": {"defaults": {"unit": "Bps"}},
      "gridPos": {"h": 8, "w": 6, "x": 18, "y": 10},
      "id": 8,
      "options": {"legend": {"displayMode": "list", "placement": "bottom"}},
      "title": "网络流量（接收/发送）",
      "type": "timeseries",
      "targets": [
        {"expr": "rate(container_network_receive_bytes_total{pod=~\"sz300-server.*\"}[5m])", "legendFormat": "RX {{pod}}", "refId": "A"},
        {"expr": "rate(container_network_transmit_bytes_total{pod=~\"sz300-server.*\"}[5m])", "legendFormat": "TX {{pod}}", "refId": "B"}
      ]
    }
    ,
    {"collapsed": false, "gridPos": {"h": 1, "w": 24, "x": 0, "y": 18}, "id": 102, "title": "应用", "type": "row"},
    {
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "fieldConfig": {"defaults": {"unit": "short"}},
      "gridPos": {"h": 8, "w": 6, "x": 0, "y": 19},
      "id": 9,
      "options": {"legend": {"displayMode": "list", "placement": "bottom"}},
      "title": "数据库连接池（活跃/空闲/最大）",
      "type": "timeseries",
      "targets": [
        {"expr": "sz300_db_pool_active", "legendFormat": "active", "refId": "A"},
        {"expr": "sz300_db_pool_idle", "legendFormat": "idle", "refId": "B"},
        {"expr": "sz300_db_pool_max", "legendFormat": "max", "refId": "C"}
      ]
    },
    {
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "fieldConfig": {"defaults": {"unit": "percent", "thresholds": {"mode": "absolute", "steps": [{"color": "red"}, {"color": "yellow", "value": 50}, {"color": "green", "value": 80}]}}},
      "gridPos": {"h": 8, "w": 6, "x": 6, "y": 19},
      "id": 10,
      "options": {"legend": {"displayMode": "list", "placement": "bottom"}},
      "title": "缓存命中率",
      "type": "timeseries",
      "targets": [
        {"expr": "sz300_cache_hits_total / (sz300_cache_hits_total + sz300_cache_misses_total) * 100", "legendFormat": "hit rate %", "refId": "A"}
      ]
    },
    {
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "fieldConfig": {"defaults": {"unit": "ops"}},
      "gridPos": {"h": 8, "w": 6, "x": 12, "y": 19},
      "id": 11,
      "options": {"legend": {"displayMode": "list", "placement": "bottom"}},
      "title": "MQTT 消息吞吐（发送/接收）",
      "type": "timeseries",
      "targets": [
        {"expr": "rate(sz300_mqtt_messages_published_total[5m])", "legendFormat": "published/s", "refId": "A"},
        {"expr": "rate(sz300_mqtt_messages_received_total[5m])", "legendFormat": "received/s", "refId": "B"}
      ]
    },
    {
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "fieldConfig": {"defaults": {"unit": "ops"}},
      "gridPos": {"h": 8, "w": 6, "x": 18, "y": 19},
      "id": 12,
      "options": {"legend": {"displayMode": "list", "placement": "bottom"}},
      "title": "事件处理速率（按类型）",
      "type": "timeseries",
      "targets": [
        {"expr": "sum(rate(sz300_events_processed_total[5m])) by (event_type)", "legendFormat": "{{event_type}}", "refId": "A"}
      ]
    }
    ,
    {"collapsed": false, "gridPos": {"h": 1, "w": 24, "x": 0, "y": 27}, "id": 103, "title": "Kubernetes 状态", "type": "row"},
    {
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "fieldConfig": {"defaults": {"unit": "short"}},
      "gridPos": {"h": 8, "w": 6, "x": 0, "y": 28},
      "id": 13,
      "options": {"legend": {"displayMode": "list", "placement": "bottom"}},
      "title": "Pod 状态（Running/Waiting/Terminated）",
      "type": "timeseries",
      "targets": [
        {"expr": "kube_pod_status_phase{pod=~\"sz300-server.*\", phase=\"Running\"}", "legendFormat": "Running", "refId": "A"},
        {"expr": "kube_pod_status_phase{pod=~\"sz300-server.*\", phase=\"Pending\"}", "legendFormat": "Pending", "refId": "B"},
        {"expr": "kube_pod_status_phase{pod=~\"sz300-server.*\", phase=\"Failed\"}", "legendFormat": "Failed", "refId": "C"}
      ]
    },
    {
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "fieldConfig": {"defaults": {"unit": "short", "thresholds": {"mode": "absolute", "steps": [{"color": "green"}, {"color": "yellow", "value": 1}, {"color": "red", "value": 5}]}}},
      "gridPos": {"h": 8, "w": 6, "x": 6, "y": 28},
      "id": 14,
      "options": {"legend": {"displayMode": "list", "placement": "bottom"}},
      "title": "Pod 重启次数（累计）",
      "type": "timeseries",
      "targets": [
        {"expr": "kube_pod_container_status_restarts_total{container=\"sz300-server\"}", "legendFormat": "{{pod}}", "refId": "A"}
      ]
    },
    {
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "fieldConfig": {"defaults": {"unit": "none", "mappings": [{"options": {"0": {"text": "DOWN", "color": "red"}, "1": {"text": "UP", "color": "green"}}, "type": "value"}]}},
      "gridPos": {"h": 8, "w": 6, "x": 12, "y": 28},
      "id": 15,
      "options": {"reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "textMode": "auto"},
      "title": "健康检查状态",
      "type": "stat",
      "targets": [
        {"expr": "probe_success{job=\"sz300-server\"}", "legendFormat": "{{instance}}", "refId": "A"}
      ]
    },
    {
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "fieldConfig": {"defaults": {"unit": "bytes"}},
      "gridPos": {"h": 8, "w": 6, "x": 18, "y": 28},
      "id": 16,
      "options": {"legend": {"displayMode": "list", "placement": "bottom"}},
      "title": "PVC 磁盘使用（日志卷）",
      "type": "timeseries",
      "targets": [
        {"expr": "kubelet_volume_stats_used_bytes{persistentvolumeclaim=\"sz300-logs\"}", "legendFormat": "used", "refId": "A"},
        {"expr": "kubelet_volume_stats_capacity_bytes{persistentvolumeclaim=\"sz300-logs\"}", "legendFormat": "capacity", "refId": "B"}
      ]
    }
  ],
  "refresh": "30s",
  "schemaVersion": 38,
  "style": "dark",
  "tags": ["sz300-server", "production"],
