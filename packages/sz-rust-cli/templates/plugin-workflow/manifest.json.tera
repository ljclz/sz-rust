{
    "name": "{{ plugin_name }}",
    "version": "1.0.0",
    "type": "workflow",
    "description": "Workflow plugin generated by sz-rust-cli",
    "generated_at": "{{ generated_at }}",
    "events_published": [
        {%- for transition in transitions %}
        {
            "name": "{{ plugin_name }}.{{ transition.from }}_to_{{ transition.to }}",
            "from": "{{ transition.from }}",
            "to": "{{ transition.to }}"
        }{%- if not loop.last %},{%- endif %}
        {%- endfor %}
    ],
    "events_subscribed": [],
    "states": [
        {%- for state in states %}
        {
            "name": "{{ state.name }}",
            "initial": {% if state.name == initial_state %}true{% else %}false{% endif %}
        }{%- if not loop.last %},{%- endif %}
        {%- endfor %}
    ],
    "transitions": [
        {%- for transition in transitions %}
        {
            "from": "{{ transition.from }}",
            "to": "{{ transition.to }}",
            "requires_approval": {% if transition.requires_approval %}true{% else %}false{% endif %}
        }{%- if not loop.last %},{%- endif %}
        {%- endfor %}
    ]
}