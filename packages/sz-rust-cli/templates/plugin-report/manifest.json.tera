{
    "name": "{{ plugin_name }}",
    "version": "1.0.0",
    "type": "report",
    "description": "Report plugin generated by sz-rust-cli",
    "generated_at": "{{ generated_at }}",
    "events_published": [],
    "events_subscribed": [],
    "dimensions": [
        {%- for dim in dimensions %}
        {
            "field": "{{ dim.field }}",
            "label": "{{ dim.field }}"
        }{%- if not loop.last %},{%- endif %}
        {%- endfor %}
    ],
    "metrics": [
        {%- for metric in metrics %}
        {
            "name": "{{ metric.name }}",
            "type": "sum",
            "field": "{{ metric.field }}",
            "label": "{{ metric.name }}"
        }{%- if not loop.last %},{%- endif %}
        {%- endfor %}
    ]
}
