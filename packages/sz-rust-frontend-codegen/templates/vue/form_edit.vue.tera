{# Vue 编辑表单模板 #}
<template>
  <div class="{{ module_name }}-edit">
    <{{ ui_tags.form }} :model="form" :rules="rules" ref="formRef" label-width="120px">
      {% for field in writable_fields %}
      <{{ ui_tags.form_item }} label="{{ field.name }}" prop="{{ field.name }}">
        {% if field.is_sensitive %}
        <{{ ui_tags.input }} v-model="form.{{ field.name }}" type="password" show-password />
        {% elif field.ts_type == "number" %}
        <{{ ui_tags.input }} v-model.number="form.{{ field.name }}" type="number" />
        {% else %}
        <{{ ui_tags.input }} v-model="form.{{ field.name }}" />
        {% endif %}
      </{{ ui_tags.form_item }}>
      {% endfor %}
      <{{ ui_tags.form_item }}>
        <{{ ui_tags.button }} type="primary" @click="handleSubmit">更新</{{ ui_tags.button }}>
        <{{ ui_tags.button }} @click="handleReset">重置</{{ ui_tags.button }}>
      </{{ ui_tags.form_item }}>
    </{{ ui_tags.form }}>
  </div>
</template>

<script setup lang="ts">
import { ref, reactive, onMounted } from 'vue'
import { useRoute } from 'vue-router'
import { {{ module_name }}Show, {{ module_name }}Update } from '@/api/{{ module_name }}'

const route = useRoute()
const formRef = ref()
const form = reactive({})
const rules = {}

const fetchDetail = async () => {
  const res = await {{ module_name }}Show(route.params.id as string)
  Object.assign(form, res.data)
}

const handleSubmit = async () => {
  await formRef.value.validate()
  await {{ module_name }}Update(route.params.id as string, form)
}
const handleReset = () => formRef.value.resetFields()

onMounted(fetchDetail)
</script>