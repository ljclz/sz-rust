{# Vue 详情页模板 #}
<template>
  <div class="{{ module_name }}-show">
    <{{ ui_tags.descriptions }} :column="2" border>
      {% for field in fields %}
      <{{ ui_tags.descriptions_item }} label="{{ field.name }}">{{ '{{' }} detail.{{ field.name }} {{ '}}' }}</{{ ui_tags.descriptions_item }}>
      {% endfor %}
    </{{ ui_tags.descriptions }}>
    <{{ ui_tags.button }} @click="goBack">返回</{{ ui_tags.button }}>
  </div>
</template>

<script setup lang="ts">
import { ref, onMounted } from 'vue'
import { useRoute, useRouter } from 'vue-router'
import { {{ module_name }}Show } from '@/api/{{ module_name }}'

const route = useRoute()
const router = useRouter()
const detail = ref<any>({})

const fetchDetail = async () => {
  const res = await {{ module_name }}Show(route.params.id as string)
  detail.value = res.data
}

const goBack = () => router.back()

onMounted(fetchDetail)
</script>