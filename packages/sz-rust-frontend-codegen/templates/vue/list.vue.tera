{# Vue 列表页模板 #}
<template>
  <div class="{{ module_name }}-list">
    {# 搜索表单骨架 #}
    <div class="search-bar">
      {% for field in fields %}
        {% if not field.is_sensitive and not field.is_primary_key %}
      <{{ ui_tags.input }} v-model="search.{{ field.name }}" placeholder="{{ field.name }}" clearable />
        {% endif %}
      {% endfor %}
      <{{ ui_tags.button }} type="primary" @click="handleSearch">搜索</{{ ui_tags.button }}>
      <{{ ui_tags.button }} @click="handleReset">重置</{{ ui_tags.button }}>
    </div>

    {# 数据表格 #}
    <{{ ui_tags.table }} :data="tableData" v-loading="loading" border>
      {% for field in fields %}
        {% if not field.is_sensitive %}
      <{{ ui_tags.table_column }} prop="{{ field.name }}" label="{{ field.name }}" />
        {% endif %}
      {% endfor %}
      <{{ ui_tags.table_column }} label="操作" fixed="right">
        <template #default="{ row }">
          <{{ ui_tags.button }} size="small" @click="handleShow(row)">查看</{{ ui_tags.button }}>
          <{{ ui_tags.button }} size="small" type="primary" @click="handleEdit(row)">编辑</{{ ui_tags.button }}>
          <{{ ui_tags.button }} size="small" type="danger" @click="handleDelete(row)">删除</{{ ui_tags.button }}>
        </template>
      </{{ ui_tags.table_column }}>
    </{{ ui_tags.table }}>

    {# 分页 #}
    <{{ ui_tags.pagination }}
      v-model:current-page="pagination.page"
      v-model:page-size="pagination.pageSize"
      :total="pagination.total"
      @change="handlePageChange"
    />
  </div>
</template>

<script setup lang="ts">
import { ref, reactive, onMounted } from 'vue'
import { {{ module_name }}List, {{ module_name }}Delete } from '@/api/{{ module_name }}'

const loading = ref(false)
const tableData = ref([])
const search = reactive({})
const pagination = reactive({ page: 1, pageSize: 20, total: 0 })

const fetchData = async () => {
  loading.value = true
  try {
    const res = await {{ module_name }}List({ ...search, ...pagination })
    tableData.value = res.data.list
    pagination.total = res.data.total
  } finally {
    loading.value = false
  }
}

const handleSearch = () => { pagination.page = 1; fetchData() }
const handleReset = () => { Object.keys(search).forEach(k => delete search[k]); fetchData() }
const handlePageChange = () => fetchData()
const handleShow = (row: any) => { /* 跳转详情 */ }
const handleEdit = (row: any) => { /* 跳转编辑 */ }
const handleDelete = async (row: any) => { await {{ module_name }}Delete(row.id); fetchData() }

onMounted(fetchData)
</script>