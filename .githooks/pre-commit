#!/usr/bin/env bash
# sz-rust pre-commit 钩子：四门禁快速检查（fmt / clippy 增量 / unwrap 铁律）
# 安装：git config core.hooksPath .githooks
set -uo pipefail
cd "$(git rev-parse --show-toplevel)"

# git commit 触发的钩子进程 PATH 可能不含 ~/.cargo/bin（Windows Git Bash 常见），
# 显式探测并追加，确保 cargo 可用
if ! command -v cargo >/dev/null 2>&1; then
  for dir in "$HOME/.cargo/bin" "$USERPROFILE/.cargo/bin"; do
    if [ -x "$dir/cargo" ] || [ -x "$dir/cargo.exe" ]; then
      export PATH="$dir:$PATH"
      break
    fi
  done
fi

echo "▶ 1/3 cargo fmt --check"
if ! cargo fmt --all --check 2>/dev/null; then
  echo "❌ 格式不合格：请运行 cargo fmt --all"
  exit 1
fi

echo "▶ 2/3 铁律 2：生产代码裸 unwrap 检查"
if [ -f scripts/check-unwrap.py ]; then
  TOTAL=$(python scripts/check-unwrap.py 2>/dev/null | grep -oE 'AUTHORITATIVE_PROD_UNWRAP: [0-9]+' | awk '{print $2}')
  if [ "${TOTAL:-0}" != "0" ]; then
    echo "⚠️ 发现 ${TOTAL} 处候选 unwrap（含 examples，生产代码需人工复核）"
  else
    echo "✅ 合规"
  fi
fi

echo "▶ 3/3 cargo clippy（工作区，-D warnings）"
if ! cargo clippy --workspace --all-targets -- -D warnings 2>/dev/null; then
  echo "❌ clippy 未通过"
  exit 1
fi

echo "✅ pre-commit 检查全部通过"
