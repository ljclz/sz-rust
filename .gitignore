/clippy_ws*.txt
/项目状态检测报告_2026-07-30.md

# === 工具脚本输出（本地分析数据，不入库）===
/tools/data/
/tools/*.log
/tools/*.txt
/tools/*.db
/tools/auto_test_errors.log
/tools/full_test_errors.log
/tools/navicat-recorder/target/

# === 脚本临时输出 ===
/scripts/missing_results.json
/scripts/__pycache__/

# === PID / 锁文件 ===
*.pid
*.lock.tmp

# === Navicat 抓包数据（本地调试用，不入库）===
/captures/

